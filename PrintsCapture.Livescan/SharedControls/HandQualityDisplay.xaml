<UserControl x:Class="PrintsCapture.Livescan.SharedControls.HandQualityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ce="clr-namespace:PrintsCapture.Prints.Enum;assembly=PrintsCapture.Prints"
             xmlns:viewModel="clr-namespace:PrintsCapture.Livescan.ViewModel"
             mc:Ignorable="d" Name="HandDisplayControl"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Width="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        
            <Canvas Margin="5" x:Name="LeftHandQuality" Grid.Column="0" HorizontalAlignment="Left" Width="60" Tag="{x:Static ce:Hand.Left}">
                <Canvas.LayoutTransform >
                    <ScaleTransform ScaleX="2" ScaleY="1.5"></ScaleTransform>
                </Canvas.LayoutTransform>
                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="30" Canvas.Left="0" Tag="{x:Static ce:HandPart.Little}" MouseDown="FingerMouseDown" />
                <Rectangle Height="10" Width="8" Fill="Gray"  Canvas.Top="40" Canvas.Left="0" />

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="12" Tag="{x:Static ce:HandPart.Ring}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="12"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="10" Canvas.Left="24" Tag="{x:Static ce:HandPart.Middle}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="30" Width="8" Fill="Gray" Canvas.Top="20" Canvas.Left="24"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="36" Tag="{x:Static ce:HandPart.Index}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="36"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="40" Canvas.Left="48" Tag="{x:Static ce:HandPart.Thumb}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="50" Canvas.Left="48"/>

            <Rectangle Height="10" Width="44" Fill="Gray" Canvas.Top="50" Canvas.Left="0"   MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.UpperPalm}"-->

            <Rectangle Height="20" Width="44" Fill="Gray" Canvas.Top="60" Canvas.Left="0"  MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.LowerPalm}"-->

            <Rectangle Height="30" Width="20" Fill="Gray" Canvas.Top="50" Canvas.Left="0"  MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.Hypothenar}"-->
            </Canvas>

        <Canvas Margin="5" x:Name="RightHandQuality" Grid.Column="1" Width="60" Tag="{x:Static ce:Hand.Right}">
                <Canvas.LayoutTransform >
                    <ScaleTransform ScaleX="2" ScaleY="1.5"></ScaleTransform>
                </Canvas.LayoutTransform>
            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="30" Canvas.Left="48" Tag="{x:Static ce:HandPart.Little}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="10" Width="8" Fill="Gray"  Canvas.Top="40" Canvas.Left="48" />

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="36" Tag="{x:Static ce:HandPart.Ring}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="36"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="10" Canvas.Left="24" Tag="{x:Static ce:HandPart.Middle}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="30" Width="8" Fill="Gray" Canvas.Top="20" Canvas.Left="24"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="12" Tag="{x:Static ce:HandPart.Index}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="12"/>

            <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="40" Canvas.Left="0" Tag="{x:Static ce:HandPart.Thumb}"  MouseDown="FingerMouseDown"/>
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="50" Canvas.Left="0"/>

            <Rectangle Height="10" Width="44" Fill="Gray" Canvas.Top="50" Canvas.Left="12" MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.UpperPalm}"-->

            <Rectangle Height="20" Width="44" Fill="Gray" Canvas.Top="60" Canvas.Left="12" MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.LowerPalm}"-->

            <Rectangle Height="30" Width="20" Fill="Gray" Canvas.Top="50" Canvas.Left="36" MouseDown="FingerMouseDown"/> <!--Tag="{x:Static ce:HandPart.Hypothenar}"-->
        </Canvas>
        <Popup x:Name="ConditionPopup" DataContext="{Binding ConditionPopupViewModel, ElementName=HandDisplayControl}" >
            <Popup.Style>
                <Style>
                    <Style.Triggers>
                        <Trigger  Property="Popup.IsMouseOver" Value="true">
                            <Setter Property="Popup.StaysOpen" Value="False"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Popup.Style>
            <Border Background="White" BorderThickness="1" BorderBrush="Black">                                
                <StackPanel Margin="5">
                    <Label FontWeight="Bold" Content="{Binding PrintName}"></Label>
                    <Label>Enter condition date when relevant</Label>
                    <DockPanel >
                        <Label DockPanel.Dock="Right">yyyy-MM-dd</Label>
                        <TextBox x:Name="ConditionDateTextBox" >
                            <Binding Path="ConditionDate" UpdateSourceTrigger="PropertyChanged" >
                                <Binding.ValidationRules>
                                    <ExceptionValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox>                                            
                    </DockPanel>
                    <TextBlock Foreground="Red" Text="{Binding FormatExceptionText}"></TextBlock>
                    
                    <ItemsControl ItemsSource="{Binding AllConditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="viewModel:ConditionElementViewModel">
                                <StackPanel Orientation="Horizontal" Background="Transparent" MouseDown="ConditionMouseDown" Tag="{Binding Status}" Name="ConditionPanel">
                                    <Image Source="{Binding Image}" Width="16"></Image>
                                    <Label Content="{Binding Label}" Margin="5,0,0,0"></Label>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="true" >
                                        <Setter  TargetName="ConditionPanel"  Property="Background" Value="Moccasin"></Setter>
                                    </DataTrigger>                                
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ConditionPanel" Property="Background" Value="LightBlue" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                                                            
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
            </Border>
        </Popup>
    </Grid>
</UserControl>
