<Window x:Class="PrintsCapture.Livescan.View.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:lng="clr-namespace:PrintsCapture.Prints.Language;assembly=PrintsCapture.Prints"
        
        xmlns:ce="clr-namespace:PrintsCapture.Prints.Enum;assembly=PrintsCapture.Prints"        
        xmlns:converter1="clr-namespace:PrintsCapture.Livescan.Converter"
        xmlns:converter2="clr-namespace:XL_ID.Utilities.Wpf.Converter;assembly=XL_ID.Utilities.Wpf"

        DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}"
        Title="{x:Static lng:CommonText.LivePreviewTitle}" Topmost="{Binding TopMostWindow}" 
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" WindowState="Normal" ResizeMode="NoResize" Loaded="WindowLoaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="FingerprintBox">
            <Setter Property="Control.BorderBrush" Value="#FF363636" />
            <Setter Property="Control.BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DeviceMessageText">
            <Setter Property="TextBlock.Foreground" Value="Crimson" />
            <Setter Property="TextBlock.FontSize" Value="20"></Setter>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"></Setter>
        </Style>
        <Style x:Key="WarningBox">
            <!--<Setter Property="Border.BorderThickness" Value="1"></Setter>-->
            <Setter Property="Control.BorderBrush" Value="#FF363636" />
            <!--<Setter Property="Border.Background" Value="Aqua"></Setter>
            <Setter Property="Border.CornerRadius" Value="25"></Setter>-->
        </Style>
        <converter2:InstanceToVisibilityConverter x:Key="VisibilityConverter" />
        <converter2:InstanceToBoolConverter x:Key="Exists" />
        
        <converter1:SequenceCheckToGaugeConverter x:Key="SequenceToGaugeConverter"></converter1:SequenceCheckToGaugeConverter>
        <converter1:QualityToGaugeConverter x:Key="QualityToGaugeConverter"></converter1:QualityToGaugeConverter>
        <converter2:NullBoolToVisibilityConverter x:Key="BoolToVisibility"></converter2:NullBoolToVisibilityConverter>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="170" />
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Style="{StaticResource FingerprintBox}" Visibility="{Binding PreviousPrint, Converter={StaticResource VisibilityConverter}}">
            <Image Grid.RowSpan="2" Source="{Binding PreviousPrint.Image}" IsEnabled="{Binding PreviousPrint, Converter={StaticResource Exists}}" Stretch="Uniform" />
        </Border>
        

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0"  Style="{StaticResource FingerprintBox}"></Border>
        <StackPanel Grid.Column="0" Grid.Row="2" Grid.RowSpan="2" Margin="0,2"  Visibility="{Binding PreviousPrint, Converter={StaticResource VisibilityConverter}}">
            <TextBlock Text="{x:Static lng:CommonText.PreviousPrint}" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="{Binding PreviousPrint.Name}" HorizontalAlignment="Center" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="{x:Static lng:CommonText.ResolutionLabel}"></Label>
                <Label Content="{Binding PreviousPrint.Resolution}"></Label>
            </StackPanel>

            <DockPanel Margin="5,0" HorizontalAlignment="Center">
                <Image DockPanel.Dock="Left" Stretch="None" Source="{Binding PreviousPrint.StatusImage}"></Image>
                <TextBlock Text="{Binding PreviousPrint.StatusMessage}" TextWrapping="Wrap"  Margin="0,10"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static lng:CommonText.QualityLabel}"  />
                <TextBlock Margin="5,0,0,0" Text="{Binding PreviousPrint.QualityScore}" />
                <Image Stretch="None" Source="{Binding PreviousPrint.QualityScore, Converter={StaticResource QualityToGaugeConverter}}"></Image>
                <!--<TextBlock Text="{Binding QualityScore, Converter={StaticResource QualityDescriptor}}" Margin="10,0,0,0" ></TextBlock>
                <TextBlock Text=" / " Margin="5,0,5,0" />
                <TextBlock Text="{Binding QualityThreshold}" />-->
                
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static lng:CommonText.MinutiaLabel}"  />
                <TextBlock Margin="5,0" Text="{Binding PreviousPrint.MinutiaCount}"></TextBlock>
            </StackPanel>
            

            <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center" Visibility="{Binding PreviousPrint.LinkedPrint.IsSequenceCheckEnabled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static lng:CommonText.SequenceLabel}" />
                <TextBlock Margin="5,0,0,0" Text="{Binding PreviousPrint.SequenceScore}"  />
                <Image Stretch="None" Source="{Binding PreviousPrint.SequenceScore, Converter={StaticResource SequenceToGaugeConverter}}" />
            </StackPanel>                                  

        </StackPanel>
        
        <Button Name="ScanAgainButton" Content="{x:Static lng:CommonText.ScanAgain}" Grid.Column="0" Grid.Row="2" Grid.RowSpan="2" Margin="10,10"  
                VerticalAlignment="Bottom" IsEnabled="{Binding PreviousPrint, Converter={StaticResource Exists}}"
                Click="ScanAgainClick" Visibility="Collapsed"></Button>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Canvas Name="LeftHandQuality" HorizontalAlignment="Left" Width="60">
                <Canvas.RenderTransform >
                    <ScaleTransform ScaleX="2" ScaleY="2"></ScaleTransform>
                </Canvas.RenderTransform>
                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="30" Canvas.Left="0" Tag="{x:Static ce:HandPart.Little}" />
                <Rectangle Height="10" Width="8" Fill="Gray"  Canvas.Top="40" Canvas.Left="0" />

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="12" Tag="{x:Static ce:HandPart.Ring}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="12"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="10" Canvas.Left="24" Tag="{x:Static ce:HandPart.Middle}" />
                <Rectangle Height="30" Width="8" Fill="Gray" Canvas.Top="20" Canvas.Left="24"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="36" Tag="{x:Static ce:HandPart.Index}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="36"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="40" Canvas.Left="48" Tag="{x:Static ce:HandPart.Thumb}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="50" Canvas.Left="48"/>

                <Rectangle Height="10" Width="44" Fill="Gray" Canvas.Top="50" Canvas.Left="0" Tag="{x:Static ce:HandPart.UpperPalm}"/>

                <Rectangle Height="20" Width="44" Fill="Gray" Canvas.Top="60" Canvas.Left="0" Tag="{x:Static ce:HandPart.LowerPalm}"/>

                <Rectangle Height="30" Width="20" Fill="Gray" Canvas.Top="50" Canvas.Left="0" Tag="{x:Static ce:HandPart.Hypothenar}"/>
            </Canvas>
            <Image Width="120" Source="{Binding ScanKindImage}" Margin="60, 0, 0, 0"></Image>
            <Canvas Name="RightHandQuality" Width="60">
                <Canvas.RenderTransform >
                    <ScaleTransform ScaleX="2" ScaleY="2"></ScaleTransform> 
                </Canvas.RenderTransform>
                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="30" Canvas.Left="48" Tag="{x:Static ce:HandPart.Little}" />
                <Rectangle Height="10" Width="8" Fill="Gray"  Canvas.Top="40" Canvas.Left="48" />

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="36" Tag="{x:Static ce:HandPart.Ring}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="36"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="10" Canvas.Left="24" Tag="{x:Static ce:HandPart.Middle}" />
                <Rectangle Height="30" Width="8" Fill="Gray" Canvas.Top="20" Canvas.Left="24"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="20" Canvas.Left="12" Tag="{x:Static ce:HandPart.Index}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="30" Canvas.Left="12"/>

                <Rectangle Height="8" Width="8" Fill="Green" Canvas.Top="40" Canvas.Left="0" Tag="{x:Static ce:HandPart.Thumb}" />
                <Rectangle Height="20" Width="8" Fill="Gray" Canvas.Top="50" Canvas.Left="0"/>

                <Rectangle Height="10" Width="44" Fill="Gray" Canvas.Top="50" Canvas.Left="12" Tag="{x:Static ce:HandPart.UpperPalm}"/>

                <Rectangle Height="20" Width="44" Fill="Gray" Canvas.Top="60" Canvas.Left="12" Tag="{x:Static ce:HandPart.LowerPalm}"/>

                <Rectangle Height="30" Width="20" Fill="Gray" Canvas.Top="50" Canvas.Left="36" Tag="{x:Static ce:HandPart.Hypothenar}"/>
            </Canvas>
        </StackPanel>

        
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource FingerprintBox}" Loaded="BorderLoaded" >
            <!--<Image Name="LivePreviewImage" Stretch="Uniform"></Image>-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <WindowsFormsHost Grid.Row="0" Grid.RowSpan="3" Name="Win32Window" Visibility="{Binding PrintCaptureVisibility}"  />
                <Border Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" Background="Gray" Visibility="{Binding PrintCaptureVisibility}" >
                    <Image Name="DisplayImage" VerticalAlignment="Bottom" Stretch="Uniform" ></Image>
                </Border>

                <DockPanel Grid.Row="1" Background="White" Visibility="{Binding DeviceMessageVisibility}">
                    <Button DockPanel.Dock="Bottom" Margin="8" Content="{x:Static lng:CommonText.ResumeCapture}" Width="200" Click="ResumeCaptureButtonClick" Visibility="{Binding ResumeButtonVisibility}"  />
                    <Viewbox>
                        <TextBlock Text="{Binding DeviceMessage}" Visibility="{Binding DeviceMessageVisibility}" />
                    </Viewbox>
                </DockPanel>
                
                <!--<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="White" Visibility="{Binding DeviceMessageVisibility}">
                    <TextBlock Text="{Binding DeviceMessage}" Style="{StaticResource DeviceMessageText}" HorizontalAlignment="Center" Visibility="{Binding DeviceMessageVisibility}" />
                    <Button Margin="8" Content="{x:Static lng:CommonText.ResumeCapture}" Width="200" Click="ResumeCaptureButtonClick" Visibility="{Binding ResumeButtonVisibility}"  />
                </StackPanel>-->
                
            </Grid>
            
        </Border>
                        
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource WarningBox}">
            <Viewbox>
                <TextBlock  TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ScanInstructionText}" />                
            </Viewbox>
            
        </Border>
        <TextBlock Grid.Row="3" Grid.Column="1" Name="QualityDebugLabel" Height="30" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="10" Visibility="Collapsed">Quality debug label</TextBlock>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeviceStateLabel}"></TextBlock>
        <Button Grid.Row="4" Grid.Column="1" Width="200" Margin="2" Content="{x:Static lng:CommonText.Close}" Click="PreviewCancelClick" />
    </Grid>
</Window>
