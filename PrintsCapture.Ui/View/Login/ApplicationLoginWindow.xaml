<Window x:Class="PrintsCapture.Livescan.View.ApplicationLoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrintsCapture.Livescan.View"
             mc:Ignorable="d" 
            Title="UniDAC Civil Login" Height="360" Width="371" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" WindowStyle="None" Icon="/UniDAC.Civil.GUI;component/Images/Logo UniDAC civil (256x256).ico" Loaded="ApplicationLoginWindow_OnLoaded" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="358*"/>
            <ColumnDefinition Width="13*"/>
        </Grid.ColumnDefinitions>
        <Button Name="CancelButton" HorizontalAlignment="Left" Margin="187,309,0,0" VerticalAlignment="Top" Width="137" Click="CancelButton_OnClick"  IsCancel="True">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/PrintsCapture.Livescan;component/Images/LoginCancel128x128.png" Height="23" Width="23"/>
                <Label Content="Cancel"/>
            </StackPanel>
        </Button>

        <TextBlock Margin="0,339,0,-339" Grid.ColumnSpan="2">
            <Hyperlink NavigateUri="http://www.xl-id.com" Foreground="White"> www.xl-id.com</Hyperlink>
        </TextBlock>
        <Label Name="StationGuidLabel" Content="macaddress" HorizontalContentAlignment="Right" Margin="129,335,0,-5" VerticalAlignment="Center" Foreground="White" Height="30" RenderTransformOrigin="1.615,0.367" Grid.ColumnSpan="2"/>
        <Image x:Name="LogoImage" HorizontalAlignment="Left" Height="78" Margin="10,10,0,0" VerticalAlignment="Top" Width="348" Stretch="Uniform"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="130" Margin="22,104,0,0" VerticalAlignment="Top" Width="120" Source="/PrintsCapture.Livescan;component/Images/UniDAC-logo-new.png" />

        <WindowsFormsHost Name="Win32Window" Visibility="{Binding PrintCaptureVisibility}" Margin="187,141,35,57" />
        <Border VerticalAlignment="Bottom" Background="Gray"  >
            <Image Name="DisplayImage" VerticalAlignment="Bottom" Stretch="Uniform" ></Image>
        </Border>

        <Label x:Name="label" Content="UniDAC Login" HorizontalAlignment="Left" Margin="157,99,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.612,0.002" Width="191" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="22" Height="42"/>
    </Grid>
</Window>
