<Window x:Class="PrintsCapture.Ui.View.PalmQualityControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:PrintsCapture.Ui.Language"
        Title="{x:Static language:Text.PalmQualityControlTitle}" 
        DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Image Grid.Row="0" Stretch="Uniform" Source="{Binding PalmImage}"></Image>
        
        <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="10" FontWeight="Bold"></TextBlock>
        
        <DockPanel Grid.Row="2" Margin="5,0">
            <Button DockPanel.Dock="Left" Click="NoButtonClick" Content="{x:Static language:Text.No}" ></Button>
            <Button DockPanel.Dock="Right" Click="YesButtonClick" Content="{x:Static language:Text.Yes}"></Button>
            <Label></Label>
        </DockPanel>
        
    </Grid>
</Window>
