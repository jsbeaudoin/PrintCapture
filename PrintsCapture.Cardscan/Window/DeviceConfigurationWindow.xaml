<Window x:Class="PrintsCapture.Cardscan.Window.DeviceConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:PrintsCapture.Prints.Language;assembly=PrintsCapture.Prints"
        xmlns:device="clr-namespace:PrintsCapture.Device;assembly=PrintsCapture.Device"       
        xmlns:converter1="clr-namespace:XL_ID.Utilities.Wpf.Converter;assembly=XL_ID.Utilities.Wpf"
        Title="Configuration" Width="424" 
        DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}" 
        Topmost="True"
        WindowStartupLocation="CenterScreen" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="ListElementTemplate" DataType="device:DeviceViewModel">
            <Grid>
                <TextBlock  Text="{Binding Label}" />
            </Grid>
        </DataTemplate>
        <converter1:StringUriToBitmapImageConverter x:Key="StringToSourceConverter"></converter1:StringUriToBitmapImageConverter>
    </Window.Resources>
    <StackPanel>
        <Image HorizontalAlignment="Center" Height="64" Width="64" Source="{Binding SelectedDevice.ImageUri, Converter={StaticResource StringToSourceConverter},
            ConverterParameter='pack://application:,,,/PrintsCapture.Livescan;component/Images/LivescanVirtual.png'}"></Image>

        <Button Width="100" Click="AutoDetectScannerButtonClick">Auto-Detect</Button>
        
        <Label Content="{x:Static language:CommonText.Device}" Height="28" Margin="12,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"  />

        <Grid Margin="50,0,25,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="15"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="5"/>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="5"/>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static language:CommonText.Model}" />
            <ComboBox Grid.Row="0" Grid.Column="2" Name="ScannerComboBox" VerticalAlignment="Top" ItemsSource="{Binding DeviceList}" DisplayMemberPath="Label" SelectedValue="{Binding SelectedDevice}" />

            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static language:CommonText.SerialNumber}" />
            <Label Grid.Row="4" Grid.Column="0" Content="{x:Static language:CommonText.Resolutions}"  />

            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SelectedDevice.SerialNumber}"></TextBox>
            <Border Grid.Row="4" Grid.Column="2" Height="56" BorderThickness="1" BorderBrush="Black">
                <TextBlock   Text="{Binding SelectedDevice.Resolutions}"></TextBlock>
            </Border>
        </Grid>

        <Grid  Margin="24,12">
            <Button Content="{x:Static language:CommonText.Cancel}" HorizontalAlignment="Left"  Name="CancelButton" Width="75" Click="btnCancel_Click" />
            <Button Content="{x:Static language:CommonText.Accept}" HorizontalAlignment="Right" Name="AcceptButton"  Width="75" Click="btnAccept_Click" />
        </Grid>

    </StackPanel>
</Window>
